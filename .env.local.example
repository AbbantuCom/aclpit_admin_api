# ── MongoDB ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Firebase (Client — public, used in the browser) ─────────────────────
# Firebase Console → Project Settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Firebase Admin (Server — private, never exposed to the browser) ─────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Session ───────────────────────────────────────────────────────────────
# Any long random string (at least 32 characters)
SESSION_SECRET=some-very-long-random-string-change-this-now

# Secret required by /api/auth/reset to reset the admin roster in an emergency
RESET_SECRET=another-long-random-string-change-this-too

# ── Cloudflare R2 (media storage) ───────────────────────────────────────
# See CLOUDFLARE_R2_SETUP.md for how to create these
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=aclpit-media
R2_PUBLIC_URL=https://media.aclpit.org

# ── Public client site (separate Next.js repo that consumes this API) ──
# Base URL of the public ACLPIT site's own backend, used to trigger cache
# revalidation there right after a content section is saved here.
CLIENT_URL=https://aclpit.org

# Comma-separated list of origins allowed to call the public content/contact
# endpoints (api/content/[section] GET and api/contact POST) cross-origin.
# Example: https://aclpit.org,https://staging.aclpit.org
CLIENT_ORIGIN=https://aclpit.org

# Shared secret sent to `${CLIENT_URL}/api/revalidate` after a content save.
# Must match the secret the public client site's revalidate route expects.
REVALIDATE_SECRET=another-long-random-string-shared-with-the-client-repo
