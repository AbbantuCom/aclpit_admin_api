# ── MongoDB ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# Database to use inside that cluster. Required — the app refuses to start a
# request without it rather than defaulting to a name and writing content into
# the wrong database.
MONGODB_DB=aclpit

# ── App ───────────────────────────────────────────────────────────────────
# Public base URL of THIS admin app. Used to build the links inside invitation
# and password-reset emails, so it must be reachable by the recipient.
# Locally this is whatever port `npm run dev` prints (often 3001 if the public
# client site already occupies 3000).
APP_URL=http://localhost:3000

# ── Session & Auth ────────────────────────────────────────────────────────
# Signs the httpOnly session cookie. Any long random string (32+ characters).
# Changing this invalidates every existing session.
SESSION_SECRET=some-very-long-random-string-change-this-now

# Guards /api/auth/dev-reset, which wipes the users, invitations and
# passwordResetTokens collections so super-admin setup can run again.
# Development only — the route refuses to run when NODE_ENV=production.
RESET_SECRET=another-long-random-string-change-this-too

# ── Email (Resend) ────────────────────────────────────────────────────────
# Sends invitation and password-reset emails. If RESEND_API_KEY is unset, the
# app does NOT fail — it logs the email (including the action link) to the
# server console instead, which keeps invites and resets testable in local dev.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be on a domain you have verified in Resend.
# Resend's shared onboarding@resend.dev works for testing but can only deliver
# to the address that owns the Resend account.
EMAIL_FROM=ACLPIT Admin <no-reply@aclpit.org>

# ── Cloudflare R2 (media storage) ───────────────────────────────────────
# See CLOUDFLARE_R2_SETUP.md for how to create these
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=aclpit-media
R2_PUBLIC_URL=https://media.aclpit.org

# ── Public client site (separate Next.js repo that consumes this API) ──
# Base URL of the public ACLPIT site, used to trigger cache revalidation there
# right after a content section is saved here.
CLIENT_URL=https://aclpit.org

# Comma-separated list of origins allowed to call the public content/contact
# endpoints (api/content/[section] GET and api/contact POST) cross-origin.
# Example: https://aclpit.org,https://staging.aclpit.org
CLIENT_ORIGIN=https://aclpit.org

# Shared secret sent to `${CLIENT_URL}/api/revalidate` after a section is
# published. Must match REVALIDATE_SECRET in the aclpit_client repo.
REVALIDATE_SECRET=another-long-random-string-shared-with-the-client-repo

# Shared secret for content previews, used for two things:
#   1. Signing the short-lived preview links this API hands to editors, which
#      open `${CLIENT_URL}/api/preview` with unpublished draft content.
#   2. Authenticating the client site's server-side reads of draft content
#      (GET /api/content/:section?state=draft), which is not public.
# Must match PREVIEW_SECRET in the aclpit_client repo. Without it (or without
# CLIENT_URL) the admin panel simply reports that preview is not configured.
PREVIEW_SECRET=a-third-long-random-string-shared-with-the-client-repo
